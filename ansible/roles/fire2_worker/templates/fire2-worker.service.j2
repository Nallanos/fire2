[Unit]
Description=fire2 worker node
Documentation=https://github.com/nallanos/fire2
After=network.target fire2-thinpool.service
# Sandbox root drives are snapshots from the thin pool: no pool, no worker
# (so it never heartbeats and never gets scheduled).
Requires=fire2-thinpool.service

# Give up after 5 failures in 60s instead of crash-looping forever on a
# config error that will never self-heal (the ~19h worker crash-loop).
# Sandboxes survive: their shims outlive the worker (KillMode=process below).
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# Runs as root: the worker drives device-mapper itself (thin volume per
# sandbox) and spawns Firecracker, with no sudo or helper script on the
# sandbox creation path.
EnvironmentFile={{ fire2_install_dir }}/worker.env
ExecStart={{ fire2_install_dir }}/worker
Restart=on-failure
RestartSec=5s
# Exit status 78: the orchestrator refused every heartbeat for 10 minutes (an
# older worker against a newer orchestrator, say). A restart would be refused
# again, so leave the unit failed, visible in `systemctl --failed`, instead of
# looping. The VMs live on (KillMode=process below).
RestartPreventExitStatus=78

# Only the worker is killed on stop/restart. Each VM runs under its own
# fire2-shim, left running on purpose: the next worker re-attaches to it, so
# a restart or redeploy does not destroy sandboxes. To stop every VM, use
# `{{ fire2_install_dir }}/worker -reap-all` with the service stopped, or
# reboot.
KillMode=process
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
