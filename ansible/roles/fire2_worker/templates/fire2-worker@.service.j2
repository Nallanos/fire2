[Unit]
Description=fire2 worker node (instance %i)
Documentation=https://github.com/nallanos/fire2
After=network.target fire2-thinpool.service
# Sandbox root drives are snapshots from the thin pool: no pool, no worker
# (so it never heartbeats and never gets scheduled).
Requires=fire2-thinpool.service

[Service]
# No NoNewPrivileges=: the worker needs sudo for fire2-thin.
User={{ fire2_user }}
Group={{ fire2_group }}
EnvironmentFile={{ fire2_install_dir }}/worker-%i.env
ExecStart={{ fire2_install_dir }}/worker
Restart=on-failure
RestartSec=5s

# Ensure the process group is killed on stop/restart — no orphan goroutines.
KillMode=mixed
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
